# Copy to mobile/.env (git-ignored). Values are compiled into the APK.
# API used by the app. Default build: the same Vercel rewrite as the web.
# A test build against a local server on the emulator host: http://10.0.2.2:5055/api/v1
EXPO_PUBLIC_API_URL=https://wqi-project.vercel.app/api/v1
# Goong map tiles key (same value as VITE_GOONG_MAPTILES_KEY in client/.env). Empty = Esri base map.
EXPO_PUBLIC_GOONG_MAPTILES_KEY=
